# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Personal plant notebook for Android (js_of_ocaml + Capacitor)"
maintainer: ["Tristan Brugère"]
authors: ["Tristan Brugère"]
license: "MIT"
homepage: "https://github.com/tbrugere/herbier"
bug-reports: "https://github.com/tbrugere/herbier/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.24"}
  "js_of_ocaml" {>= "6.0"}
  "js_of_ocaml-compiler" {>= "6.0"}
  "brr"
  "react"
  "reactiveData"
  "ptime"
  "uuidm"
  "yojson"
  "postgrest" {= version}
  "alcotest" {with-test}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tbrugere/herbier.git"
x-maintenance-intent: ["(latest)"]
