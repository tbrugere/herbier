<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Pl@ntNet's hosts only (docs/architecture.md §7, user decision
                 2026-11-12); app/domain/link.ml classifies these and the other
                 reference hosts, which are recognised only when pasted or shared
                 as text. pathPattern's ".*" never backtracks: one pattern per
                 path depth. -->

            <!-- Pl@ntNet -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="identify.plantnet.org" />
                <data android:pathPattern="/.*/species/.*" />
                <data android:pathPattern="/.*/.*/species/.*" />
                <data android:pathPattern="/.*/observations/.*" />
                <data android:pathPattern="/.*/.*/observations/.*" />
            </intent-filter>

            <!-- Pl@ntUse: plantuse.plantnet.org is current, the two others are older links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="plantuse.plantnet.org" />
                <data android:host="uses.plantnet.org" />
                <data android:host="uses.plantnet-project.org" />
                <data android:pathPattern="/.*/.*" />
            </intent-filter>

            <!-- Android share sheet (@capgo/capacitor-share-target). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor/geolocation: the GPS fix of a new observation (handoff 4d). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- getUserMedia in the WebView: Capacitor's BridgeWebChromeClient grants
         VIDEO_CAPTURE only after the CAMERA runtime permission (4d viewfinder). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
