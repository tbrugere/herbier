<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Capacitor Preferences holds the Supabase session
     (refresh token): it stays on the device. Same rule as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
