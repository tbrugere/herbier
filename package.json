{
  "name": "herbier",
  "private": true,
  "version": "0.0.0",
  "description": "Personal plant notebook for Android; the app itself is OCaml (see dune-project)",
  "scripts": {
    "web": "dune build @web",
    "dev": "scripts/dev.sh",
    "emu:start": "scripts/emulator.sh start",
    "emu:stop": "scripts/emulator.sh stop",
    "emu:install": "scripts/emulator.sh install",
    "emu:install-web": "scripts/emulator.sh install-web",
    "emu:open": "scripts/emulator.sh open",
    "release": "scripts/release.sh",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:schema:dump": "uv run supabase/scripts/schema-dump.py",
    "db:schema:check": "uv run supabase/scripts/schema-dump.py --check",
    "db:catalog:dump": "scripts/catalog-dump.sh",
    "db:catalog:check": "scripts/catalog-dump.sh --check",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capgo/capacitor-share-target": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.0.0",
    "@capgo/capacitor-uploader": "^8.0.0",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.17.0",
    "pmtiles": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0",
    "sass": "^1.80.0",
    "supabase": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
