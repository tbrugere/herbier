; Sync on the device: the account (auth/: Auth, with Auth.Server, the GoTrue
; calls), the PostgREST transport over fetch (net/), the engine that runs the
; cycles and the keep-alive job's side (keepalive/). The pure halves are
; herbier_sync_core (app/sync_core/); Auth re-exports its Session and Gotrue,
; Keepalive its Wire and Report. Sub-directories are qualified:
; auth/auth.ml and keepalive/keepalive.ml are their groups' main modules.
(include_subdirs qualified)

(library
 (name herbier_sync)
 (public_name herbier.sync)
 (libraries
  herbier_sync_core
  herbier_domain
  herbier_net
  herbier_store
  herbier_store_io
  herbier_bindings
  postgrest
  uri
  yojson
  ptime
  ptime.clock.os
  brr)
 (preprocess
  (pps ppx_deriving.eq ppx_deriving.show ppx_deriving_yojson)))

; backend.ml: this build's backend and Google values (Supabase URL,
; publishable key, Google web client id), from
; the environment at build time. Outside the release profile, the URL and key default to
; the local stack (`supabase start`, reached from the emulator through
; `adb reverse tcp:54321 tcp:54321`; the key is the CLI's fixed local
; publishable key); the client id has no default.
; Values sit inside {|…|}, so a value containing |} is not supported.
(rule
 (target backend.ml)
 (enabled_if (<> %{profile} release))
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(* generated by app/sync/dune *)\n")
    (echo
     "let supabase_url = {|%{env:HERBIER_SUPABASE_URL=http://127.0.0.1:54321}|}\n")
    (echo
     "let publishable_key = {|%{env:HERBIER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH}|}\n")
    (echo
     "let google_web_client_id = {|%{env:HERBIER_GOOGLE_WEB_CLIENT_ID=}|}\n")))))

(rule
 (target backend.ml)
 (enabled_if (= %{profile} release))
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(* generated by app/sync/dune *)\n")
    (echo "let supabase_url = {|%{env:HERBIER_SUPABASE_URL=}|}\n")
    (echo "let publishable_key = {|%{env:HERBIER_SUPABASE_PUBLISHABLE_KEY=}|}\n")
    (echo
     "let google_web_client_id = {|%{env:HERBIER_GOOGLE_WEB_CLIENT_ID=}|}\n")))))
