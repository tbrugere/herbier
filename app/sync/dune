; Supabase auth and the outbox push/pull over PostgREST; engine.ml runs the
; cycles on the device. Sub-directories are qualified: auth/auth.ml is the
; group's main module (Auth, with Auth.Session, Auth.Nonce, Auth.Gotrue,
; Auth.Server), keepalive/keepalive.ml too (Keepalive, with Keepalive.Wire,
; Keepalive.Report); net/ and cycle/ have none (Net.Rest, Net.Transport;
; Cycle.Push, Cycle.Pull, Cycle.Schedule, …). The pure modules
; (auth/session, auth/nonce, auth/gotrue, synced, json_read, net/rest,
; keepalive/wire, keepalive/report and all of cycle/) must not reference
; Brr, Fut, Jv or Herbier_bindings: test/sync compiles them natively through
; copy_files.
(include_subdirs qualified)

(library
 (name herbier_sync)
 (public_name herbier.sync)
 (libraries
  herbier_domain
  herbier_store
  herbier_bindings
  postgrest
  uri
  yojson
  ptime
  ptime.clock.os
  brr)
 (preprocess
  (pps ppx_deriving.eq ppx_deriving.show ppx_deriving_yojson)))

; backend.ml: where this build signs in (Supabase URL, publishable key,
; Google web client id), from the environment at build time. Outside the
; release profile, the URL and key default to the local stack
; (`supabase start`, reached from the emulator through
; `adb reverse tcp:54321 tcp:54321`; the key is the CLI's fixed local
; publishable key); the client id has no default. Values sit inside {|…|},
; so a value containing |} is not supported.
(rule
 (target backend.ml)
 (enabled_if (<> %{profile} release))
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(* generated by app/sync/dune *)\n")
    (echo
     "let supabase_url = {|%{env:HERBIER_SUPABASE_URL=http://127.0.0.1:54321}|}\n")
    (echo
     "let publishable_key = {|%{env:HERBIER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH}|}\n")
    (echo
     "let google_web_client_id = {|%{env:HERBIER_GOOGLE_WEB_CLIENT_ID=}|}\n")))))

(rule
 (target backend.ml)
 (enabled_if (= %{profile} release))
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(* generated by app/sync/dune *)\n")
    (echo "let supabase_url = {|%{env:HERBIER_SUPABASE_URL=}|}\n")
    (echo "let publishable_key = {|%{env:HERBIER_SUPABASE_PUBLISHABLE_KEY=}|}\n")
    (echo
     "let google_web_client_id = {|%{env:HERBIER_GOOGLE_WEB_CLIENT_ID=}|}\n")))))
