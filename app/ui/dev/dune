; The recorded Pl@ntNet answers, embedded for #dev/identify's replay block
; (Dev.Identify_replay). Dev pages only: the release build links no Dev
; module, so none of this ships.

(rule
 (target identify_fixtures.ml)
 (deps
  %{project_root}/test/fixtures/plantnet_identify_one_auto_200.json
  %{project_root}/test/fixtures/plantnet_identify_two_flower_leaf_200.json
  %{project_root}/test/fixtures/plantnet_identify_not_plant_404.json
  %{project_root}/test/fixtures/plantnet_identify_not_plant_no_reject_404.json
  %{project_root}/test/fixtures/plantnet_identify_invalid_key_401.json
  %{project_root}/test/fixtures/plantnet_projects_origin_refused_403.json
  %{project_root}/test/fixtures/plantnet_projects_fr_200.json)
 (action
  (with-stdout-to
   identify_fixtures.ml
   (progn
    (echo "(* generated by app/ui/dev/dune from test/fixtures/. *)\n")
    (echo "let one_auto_200 = {json|")
    (cat %{project_root}/test/fixtures/plantnet_identify_one_auto_200.json)
    (echo "|json}\n")
    (echo "let two_flower_leaf_200 = {json|")
    (cat %{project_root}/test/fixtures/plantnet_identify_two_flower_leaf_200.json)
    (echo "|json}\n")
    (echo "let not_plant_404 = {json|")
    (cat %{project_root}/test/fixtures/plantnet_identify_not_plant_404.json)
    (echo "|json}\n")
    (echo "let not_plant_no_reject_404 = {json|")
    (cat %{project_root}/test/fixtures/plantnet_identify_not_plant_no_reject_404.json)
    (echo "|json}\n")
    (echo "let invalid_key_401 = {json|")
    (cat %{project_root}/test/fixtures/plantnet_identify_invalid_key_401.json)
    (echo "|json}\n")
    (echo "let origin_refused_403 = {json|")
    (cat %{project_root}/test/fixtures/plantnet_projects_origin_refused_403.json)
    (echo "|json}\n")
    (echo "let projects_fr_200 = {json|")
    (cat %{project_root}/test/fixtures/plantnet_projects_fr_200.json)
    (echo "|json}\n")))))
