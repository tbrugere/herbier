; herbier_version.ml: `let git = "<git describe>"` for the User-Agent string.
; Its own leaf library so that a new commit (the rule depends on the whole
; universe) rebuilds it and what links it, not domain and everything above.
(library
 (name herbier_version)
 (public_name herbier.version))

(rule
 (target herbier_version.ml)
 (deps (universe))
 (action
  (with-stdout-to
   %{target}
   (run sh -c "root=\"${PWD%%/_build/*}\"; printf '(* generated by app/version/dune *)\\nlet git = \"%s\"\\n' \"$(git -C \"$root\" describe --always --dirty --tags 2>/dev/null || echo unknown)\""))))
