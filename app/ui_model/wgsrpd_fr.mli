(** French names of the WGSRPD areas (TDWG's World Geographical Scheme for
    Recording Plant Distributions), the codes of GBIF's WCVP distribution rows.
    Generated by scripts/wgsrpd-fr.py: Wikidata's French labels of the items
    with P11897 (CC0), first letter capitalised, and
    scripts/wgsrpd-fr-overrides.tsv for the level-3 areas Wikidata does not
    label. Pure data. *)

val generated_on : string
(** ["2026-11-21"]: the day of the Wikidata query. *)

val name : string -> string option
(** [name code]: the French name of a WGSRPD code as GBIF writes it after
    ["TDWG:"] (["BGM"], ["CZE-SL"], ["2"]), exact match (case-sensitive); [None]
    for any other string, [""] included. Never raises. *)
