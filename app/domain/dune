; Types and rules, pure except Ids.fresh, which reads the wall clock and a
; self-seeded RNG for UUID v7. No Brr: builds natively for tests.
(library
 (name herbier_domain)
 (public_name herbier.domain)
 (libraries ptime ptime.clock.os uuidm))

; version.ml: `let git = "<git describe>"` for the User-Agent string.
(rule
 (target version.ml)
 (deps (universe))
 (action
  (with-stdout-to
   %{target}
   (run sh -c "root=\"${PWD%%/_build/*}\"; printf '(* generated by app/domain/dune *)\\nlet git = \"%s\"\\n' \"$(git -C \"$root\" describe --always --dirty --tags 2>/dev/null || echo unknown)\""))))
