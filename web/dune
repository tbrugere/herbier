; The static shell. `dune build @web` fills dist/ (a directory target) with
; index.html, app.css (sass), vendor.js (esbuild), app.js (jsoo output) and
; the static folders. Capacitor's webDir points at _build/default/web/dist.
(dirs :standard \ node_modules)

(rule
 (alias web)
 (targets (dir dist))
 (deps
  index.html
  (source_tree sass)
  (source_tree fonts)
  (source_tree img)
  (source_tree js)
  (source_tree map)
  ../app/main.bc.js
  %{project_root}/scripts/build-web.sh)
 (action
  (run bash %{project_root}/scripts/build-web.sh %{project_root}/app/main.bc.js dist)))
