# --- Supabase CLI
supabase/.temp/
supabase/.branches/

# --- Python scripts run with uv
.venv/
__pycache__/

# --- Editors and OS
.lavish/
.DS_Store
.idea/
.vscode/
*.swp
.review-report/
.implement/

# direnv: local env and secrets
.envrc
# production build settings: never committed (see .env.prod.example)
.env.prod
.env.*.local
# signing keys and the rotation lineage: never in the repo (.env.prod.example)
*.jks
*.keystore
*.p12
*-lineage
keys/
