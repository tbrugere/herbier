; Directories dune must not scan: JS deps, the generated Android project,
; docs and the review pages. Only app/, lib/, web/ and test/ have dune
; files; supabase/ is data only, read by the tables.ml rule and its tests.
(dirs :standard \ node_modules android docs .lavish)

(data_only_dirs supabase)

; Dune lang 3.24 no longer enables the strict unused-variable warnings in
; the dev profile; bring back what older dune versions errored on: unused
; pattern/parameter variables (27) and unused values, opens, types,
; constructors, fields and rec flags (32..39).
(env
 (dev
  (flags (:standard -w +27+32..39))))
