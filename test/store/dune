; Native checks of herbier_store (app/store/: the local schema SQL, the
; store's value codec and the per-table query modules), run through the
; sqlite3 command-line tool. They check the SQL and the codec, not the
; Capacitor plugin: the device checks are the #dev/store and #dev/seed pages.
; sqlite_cli.ml holds the helpers the tests share. sqlite3 is a test
; dependency: the build fails without it, and the suite fails rather than
; skipping the SQL checks when this sqlite3 has no FTS5.

(tests
 (names
  test_store
  test_queries
  test_outbox
  test_references
  test_ref_images
  test_commune_packs
  test_place_renames
  test_sync_state
  test_uploads
  test_drive_trash)
 (libraries
  herbier_store
  herbier_domain
  herbier_photos
  herbier_refs
  herbier_test_support
  postgrest
  yojson
  ptime
  alcotest)
 (preprocess
  (pps ppx_deriving.eq))
 (deps %{bin:sqlite3})
 (action
  (setenv
   SQLITE3
   %{bin:sqlite3}
   (run %{test}))))
