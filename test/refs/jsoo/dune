; js_of_ocaml build of herbier_refs, run under node: under jsoo's 32-bit
; int, Yojson.Safe decodes keys above 2^31 as `Intlit, which the native
; suite never sees. Fixtures are embedded into fixtures.ml because reading a
; file under jsoo/node is not assumed to work. NODE_OPTIONS is cleared so a
; preload in the developer's shell cannot alter the run.

(rule
 (target fixtures.ml)
 (deps
  %{project_root}/test/fixtures/gbif_plantnet_media_5414995.json
  %{project_root}/test/fixtures/gbif_plantnet_media_5405976.json
  %{project_root}/test/fixtures/gbif_species_5414995.json)
 (action
  (with-stdout-to
   fixtures.ml
   (progn
    (echo "(* generated by test/refs/jsoo/dune. *)\n")
    (echo "let plantnet_digitalis = {json|")
    (cat %{project_root}/test/fixtures/gbif_plantnet_media_5414995.json)
    (echo "|json}\n")
    (echo "let plantnet_arnica = {json|")
    (cat %{project_root}/test/fixtures/gbif_plantnet_media_5405976.json)
    (echo "|json}\n")
    (echo "let species_digitalis = {json|")
    (cat %{project_root}/test/fixtures/gbif_species_5414995.json)
    (echo "|json}\n")))))

(executable
 (name smoke)
 (modes js)
 (modules smoke fixtures)
 (libraries herbier_refs yojson))

(rule
 (alias runtest)
 (action
  (setenv
   NODE_OPTIONS
   ""
   (run node %{dep:smoke.bc.js}))))
