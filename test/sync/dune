; Native checks of herbier_sync_core (app/sync_core/), linked natively.
; test_sync runs the session/nonce/gotrue suites; test_lifecycle those of
; auth/lifecycle.ml; test_rest those of synced.ml and net/rest.ml, with
; test_synced's and test_push_order's; test_cycle those of cycle/, over
; cli_local.ml's Local.S (the sqlite3 CLI, Mock_http's identity IO);
; test_keepalive those of keepalive/ (see its stanza).
;
; The shared helpers (and the copied mock_http.ml and sqlite_cli.ml) form
; herbier_sync_helpers, unwrapped so that they keep their bare names: the
; tests and handoff_sample.exe both link them, and a module belongs to one
; stanza. handoff_sample prints the hand-off test/runner reads.
(copy_files# ../postgrest/mock_http.ml)

(copy_files# ../store/sqlite_cli.ml)

(library
 (name herbier_sync_helpers)
 (wrapped false)
 (modules
  :standard
  \
  test_sync
  test_lifecycle
  test_rest
  test_cycle
  test_keepalive
  test_push_order
  test_synced
  handoff_sample)
 (libraries
  herbier_sync_core
  herbier_store
  herbier_domain
  herbier_net
  herbier_test_support
  postgrest
  postgrest-codegen
  yojson
  ptime
  uri
  alcotest)
 (preprocess
  (pps ppx_deriving.eq ppx_deriving.show ppx_deriving_yojson)))

(executable
 (name handoff_sample)
 (modules handoff_sample)
 (libraries
  herbier_sync_helpers
  herbier_sync_core
  herbier_store
  herbier_domain
  herbier_test_support
  postgrest
  yojson
  ptime
  uri))

(tests
 (names test_sync test_lifecycle test_rest test_cycle)
 (modules
  test_sync
  test_lifecycle
  test_rest
  test_cycle
  test_push_order
  test_synced)
 (libraries
  herbier_sync_helpers
  herbier_sync_core
  herbier_store
  herbier_test_support
  herbier_domain
  postgrest
  postgrest-codegen
  yojson
  ptime
  uri
  alcotest)
 (preprocess
  (pps ppx_deriving.eq ppx_deriving.show ppx_deriving_yojson))
 (deps
  %{bin:sqlite3}
  %{project_root}/supabase/schema/catalog.json
  (glob_files %{project_root}/test/fixtures/gotrue_*.json)
  (glob_files %{project_root}/test/fixtures/sync_*.json))
 (action
  (setenv SQLITE3 %{bin:sqlite3} (run %{test}))))

; test_keepalive in a stanza of its own: it alone needs what test/runner's
; node test writes, hence node.
(test
 (name test_keepalive)
 (modules test_keepalive)
 (libraries
  herbier_sync_helpers
  herbier_sync_core
  herbier_store
  herbier_test_support
  herbier_domain
  postgrest
  yojson
  ptime
  uri
  alcotest)
 (deps
  %{bin:sqlite3}
  %{project_root}/capacitor.config.ts
  %{project_root}/web/runner/keepalive.js
  (glob_files %{project_root}/test/fixtures/gotrue_*.json)
  (glob_files %{project_root}/test/fixtures/sync_*.json)
  %{project_root}/test/runner/kv_after.json
  %{project_root}/test/runner/report.json
  %{project_root}/test/runner/report_with_session.json
  %{project_root}/test/runner/lines.json)
 (action
  (setenv SQLITE3 %{bin:sqlite3} (run %{test}))))
