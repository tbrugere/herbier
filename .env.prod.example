# Production build settings, read by scripts/release.sh only. Copy to
# .env.prod (git-ignored) and replace every <...>; dev builds never read it.
# Project URL (dashboard → Project Settings → Data API).
HERBIER_SUPABASE_URL='https://<project-ref>.supabase.co'
# Publishable key (dashboard → Project Settings → API Keys), never the secret one.
HERBIER_SUPABASE_PUBLISHABLE_KEY='sb_publishable_<key>'
# Google OAuth Web client id (Google Cloud console → Credentials).
HERBIER_GOOGLE_WEB_CLIENT_ID='<number>-<id>.apps.googleusercontent.com'

# release.sh needs the full git history and origin/main: the versionCode is
# main's commit count at the merge base with HEAD, so `git fetch` first or
# the code may sit below the one already on the phone.

# Release key (keep the keystore outside the repo, and backed up: an APK
# signed with another key cannot update the installed app without an
# uninstall, which deletes its database). Made once with
#   keytool -genkeypair -keystore ~/keys/herbier-release.jks -alias herbier \
#     -keyalg RSA -keysize 4096 -validity 10000
# A path may start with ~/, be absolute, or be relative to the repo root
# (then pointing outside the checkout, e.g. ../keys/...). Set, it also signs
# `scripts/release.sh --debug`, so the two replace each other in place; that
# debug build is debuggable (`adb shell run-as` reads its database and
# session): never let it leave this machine.
HERBIER_RELEASE_KEYSTORE='<path/to/herbier-release.jks>'
HERBIER_RELEASE_KEYSTORE_PASSWORD='<store password>'
HERBIER_RELEASE_KEY_ALIAS='<alias>'
HERBIER_RELEASE_KEY_PASSWORD='<key password>'

# The switch of an install signed with the previous key (the debug key the
# installed APK was built with) to the release key, by APK key rotation
# (Android 9+). Leave all five commented out unless that install exists, and
# comment them out again once one rotated release is installed: an APK signed
# by the release key alone updates the rotated install, so later releases
# need none of them. The lineage is
# made once with (the debug keystore is
# wherever the SDK keeps it, by default ~/.android/debug.keystore)
#   apksigner rotate --out ~/keys/herbier-lineage \
#     --old-signer --ks ~/.android/debug.keystore \
#       --ks-key-alias androiddebugkey --ks-pass pass:android \
#     --new-signer --ks ~/keys/herbier-release.jks --ks-key-alias herbier
# HERBIER_SIGNING_LINEAGE='<path/to/herbier-lineage>'
# HERBIER_PREVIOUS_KEYSTORE='<path/to/debug.keystore>'
# HERBIER_PREVIOUS_KEY_ALIAS='androiddebugkey'
# HERBIER_PREVIOUS_KEYSTORE_PASSWORD='android'
# HERBIER_PREVIOUS_KEY_PASSWORD='android'
